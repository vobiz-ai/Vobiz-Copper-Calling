# Deployment settings only. No Vobiz Auth ID, Auth Token, number, endpoint id
# or application id, and no Copper API key, belongs in this file: agents sign
# in from the softphone. Copy to backend/.env (gitignored) and fill in.

PORT=8099

# The public https URL Vobiz, Copper and the agents' browsers reach this
# server on. Behind a tunnel, this is the tunnel's URL. Signature checks, the
# Copper OAuth redirect (<PUBLIC_BASE_URL>/copper/oauth/callback) and the
# Copper embedded app URL (<PUBLIC_BASE_URL>/copper) are built from it.
PUBLIC_BASE_URL=https://calling.example.com

# The Copper OAuth app. Copper registers OAuth apps on request and issues the
# client id and secret; give them the redirect URL above. Leave both empty to
# have agents connect with a Copper API key and their email instead.
COPPER_CLIENT_ID=
COPPER_CLIENT_SECRET=

# With an OAuth app set up, "false" hides the API-key option.
COPPER_ALLOW_API_KEYS=true

# OAuth users who may change the calling settings, comma separated. The
# Copper API does not report roles; API-key users are always admins, because
# only Copper admins can generate keys.
COPPER_ADMIN_EMAILS=

# Origins allowed to frame the Copper panel (/copper), comma separated.
COPPER_FRAME_ORIGINS=https://app.copper.com

# 32+ random bytes. Signs recording links. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIGNING_SECRET=

# 32 random bytes as 64 hex characters. Encrypts stored Copper OAuth tokens
# and API keys. Generate the same way as SIGNING_SECRET.
TOKEN_ENC_KEY=

# Where endpoint ids, Copper accounts, panel links and encrypted credentials
# are kept (mode 0600).
DATA_DIR=./data

# Country for numbers typed without a country code (IN, US, GB, AE, SG, AU, ...).
# Each Copper account can override it in Settings.
DEFAULT_COUNTRY=IN

# Default lifetime of recording links, in seconds. Settings can change it.
# The link in the Copper activity stops working once it expires.
RECORDING_LINK_TTL_SECONDS=900

# How the softphone registers with Vobiz. "jwt" (default): a short-lived
# access token per agent, signed by Vobiz with the account's Auth Token, so
# the browser never holds a long-lived secret. "endpoint": one SIP endpoint
# per agent, with a password rotated at each sign-in.
VOBIZ_SIP_AUTH=jwt

# Access-token lifetime in seconds (180 to 86400). The softphone fetches a new
# token a minute before this runs out and registers again.
VOBIZ_JWT_TTL_SECONDS=3600

# Vobiz callback signatures: require (default) | verify | off. Leave it on
# "require" in production. "verify" accepts an unsigned request but rejects a
# wrong one.
VOBIZ_WEBHOOK_SIGNATURES=require

# Hosts that may receive the Vobiz Auth ID and Token when recording audio is
# fetched, comma separated; "*." matches subdomains. Other hosts (presigned
# storage URLs) are fetched without credentials.
VOBIZ_MEDIA_HOSTS=*.vobiz.ai
